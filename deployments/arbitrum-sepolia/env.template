# =============================================================
# Sepehr — Arbitrum Sepolia public dry-run deployment
# =============================================================
# Copy to `.env.arbitrum-sepolia` in this directory and fill in.
# The `.env.*` rule at repo root keeps this file out of git.
# TESTNET KEYS ONLY — never reuse on mainnet.
# =============================================================


# -------------------------------------------------------------
# RPC — Arbitrum Sepolia (chainId 421614)
#   Alchemy: https://arb-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>
#   Public fallback: https://sepolia-rollup.arbitrum.io/rpc
# -------------------------------------------------------------
RPC_ARBITRUM_SEPOLIA_PRIMARY_HTTP=


# -------------------------------------------------------------
# Deployer EOA (the wallet that signs every tx in the dry-run)
# -------------------------------------------------------------
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=


# -------------------------------------------------------------
# Ownership — testnet uses the same EOA for deployer / owner / guardian.
# Mainnet MUST use a multisig owner + a separate guardian EOA.
# -------------------------------------------------------------
SEPEHR_OWNER=
SEPEHR_PAUSE_GUARDIAN=


# -------------------------------------------------------------
# Keeper EOA — address to whitelist via addKeeper. On a solo-operator
# dry-run, reusing DEPLOYER_ADDRESS is fine. When a dedicated keeper
# EOA is introduced later, update both this value and the
# `KEEPER_PRIVATE_KEY_ARBITRUM_SEPOLIA` in keeper/.env.
# -------------------------------------------------------------
KEEPER_ADDRESS=


# -------------------------------------------------------------
# SepehrCore knobs — Arbitrum Sepolia dry-run defaults
#   MIN_COLLATERAL_USD = 0                 (no floor, test dust positions)
#   TVL_CAP_USD        = type(uint256).max (no cap)
# Mainnet defaults (for reference): 500e8 + 7_500_000_000_000.
# -------------------------------------------------------------
SEPEHR_MIN_COLLATERAL_USD=0
SEPEHR_TVL_CAP_USD=115792089237316195423570985008687907853269984665640564039457584007913129639935


# -------------------------------------------------------------
# Subscription asset — Circle USDC faucet on Arbitrum Sepolia.
# Users mint via https://faucet.circle.com (6 decimals).
# -------------------------------------------------------------
USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d


# -------------------------------------------------------------
# Aave V3 Arbitrum Sepolia — source: bgd-labs/aave-address-book
#   AaveV3ArbitrumSepolia.sol @ main branch
# -------------------------------------------------------------
AAVE_POOL=0xBfC91D59fdAA134A4ED45f7B584cAf96D7792Eff
AAVE_ATOKEN=0x460b97BD498E1157530AEb3086301d5225b91216


# -------------------------------------------------------------
# Uniswap V3 on Arbitrum Sepolia — wrapped by the UniswapV3Router the
# deploy script whitelists. SepehrCore.execute requires a whitelisted
# router even for a same-asset rescue. This SwapRouter is SwapRouter02
# (no `deadline` field), the only one on Arbitrum Sepolia: a rescue that
# swaps reverts on the testnet, a same-asset rescue never calls it.
# Source: docs.uniswap.org/contracts/v3/reference/deployments/arbitrum-deployments
# -------------------------------------------------------------
UNIV3_SWAP_ROUTER=0x101F443B4d1b059569D643917553c771E1b9663E
UNIV3_FACTORY=0x248AB79Bbb9bC29bB72f7Cd42F17e054Fc40188e
UNIV3_DEFAULT_FEE=500


# -------------------------------------------------------------
# WETH address on Arbitrum Sepolia (optional). If set the deploy script
# registers a mock oracle ($3000 * 1e8) for WETH so tier-cap pre-flight
# works on WETH positions.
# -------------------------------------------------------------
WETH_ADDRESS=


# -------------------------------------------------------------
# Protocol key — keccak256("aave-v3-arbitrum-sepolia").
# Must match the `key` field in shared/config/protocols.json.
# -------------------------------------------------------------
PROTOCOL_KEY_AAVE=0x2205ba6277ac479d17179eec08f59c78bb6b324086f0b126f0ce6d309cc49835


# -------------------------------------------------------------
# Arbiscan API — same key as the Etherscan V2 multichain key used for
# Base Sepolia. Free tier at https://etherscan.io/myapikey.
# foundry.toml reads this as `${ARBISCAN_API_KEY}`.
# -------------------------------------------------------------
ARBISCAN_API_KEY=


# -------------------------------------------------------------
# Post-deploy — renseigner APRÈS le broadcast (sortie de forge script).
# -------------------------------------------------------------
SEPEHR_CORE=
SEPEHR_TIMELOCK=
AAVE_ADAPTER=
AAVE_FLASH=
DEX_ROUTER=
MOCK_ETH_ORACLE=
MOCK_USDC_ORACLE=
