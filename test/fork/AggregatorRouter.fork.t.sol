pragma solidity ^0.8.28;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";

import {AggregatorRouter} from "../../src/dex/AggregatorRouter.sol";
import {AggregatorSelectors} from "../../src/dex/AggregatorSelectors.sol";
import {SepehrErrors} from "../../src/libraries/SepehrErrors.sol";
import {ForkTestBase} from "./ForkTestBase.sol";

/// @title Lot 7 on Arbitrum One: AggregatorRouter replays real KyberSwap and Velora calldata.
/// @dev The calldata was built by each aggregator's API on 2026-10-08, with the routers below as
/// sender and recipient, and runs on a fork pinned to the block read right after. Skipped
/// without `RPC_ARBITRUM_PRIMARY_HTTP` (the RPC must serve that block's state).
contract AggregatorRouterArbitrumForkTest is ForkTestBase {
    uint256 constant FORK_BLOCK = 512_922_786;
    address constant KYBERSWAP = 0x6131B5fae19EA4f9D964eAc0408E4408b66337b5;
    address constant VELORA = 0x6A000F20005980200259B80c5102003040001068;
    address constant WETH = 0x82aF49447D8a07e3bd95BD0d56f35241523fBab1;
    address constant USDC = 0xaf88d065e77c8cC2239327C5EDb3A432268e5831;
    /// @dev The addresses the test deploys its two routers at, which the calldata pays.
    address constant KYBER_ROUTER = 0x5615dEB798BB3E4dFa0139dFa1b3D433Cc23b72f;
    address constant VELORA_ROUTER = 0x2e234DAe75C793f67A35089C9d99245E1C58470b;

    /// @dev 3 WETH for USDC through KyberSwap (`swap`), quoted at 7368428146 USDC.
    uint256 constant KYBER_QUOTE = 7_368_428_146;
    bytes constant KYBER_3_WETH =
        hex"";
    /// @dev 3 WETH for USDC through Velora (`swapExactAmountIn`), quoted at 7370536790 USDC.
    uint256 constant VELORA_QUOTE = 7_370_536_790;
    bytes constant VELORA_3_WETH =
        hex"";
    /// @dev 0.01 WETH for USDC through Velora's direct Uniswap V3 path, quoted at 24558500 USDC.
    uint256 constant VELORA_SMALL_QUOTE = 24_558_500;
    bytes constant VELORA_SMALL_WETH =
        hex"";

    AggregatorRouter internal kyber;
    AggregatorRouter internal velora;
    bool internal forked;

    function setUp() public {
        forked = _tryCreateForkAtBlock("RPC_ARBITRUM_PRIMARY_HTTP", FORK_BLOCK);
        if (!forked) return;
        kyber = new AggregatorRouter(KYBERSWAP, KYBERSWAP, AggregatorSelectors.kyberSwap());
        velora = new AggregatorRouter(VELORA, VELORA, AggregatorSelectors.velora());
        assertEq(address(kyber), KYBER_ROUTER, "the KyberSwap calldata pays this address");
        assertEq(address(velora), VELORA_ROUTER, "the Velora calldata pays this address");
        deal(WETH, address(this), 10 ether);
        IERC20(WETH).approve(address(kyber), type(uint256).max);
        IERC20(WETH).approve(address(velora), type(uint256).max);
    }

    function _expectClean(
        AggregatorRouter router
    ) internal view {
        assertEq(IERC20(WETH).balanceOf(address(router)), 0, "no WETH left in the router");
        assertEq(IERC20(USDC).balanceOf(address(router)), 0, "no USDC left in the router");
        assertEq(IERC20(WETH).allowance(address(router), router.SPENDER()), 0, "approval cleared");
    }

    function test_kyberSwap_sellsWethAtItsQuote() public {
        if (!forked) return;
        uint256 out = kyber.swap(WETH, USDC, 3 ether, (KYBER_QUOTE * 99) / 100, KYBER_3_WETH);
        assertGe(out, (KYBER_QUOTE * 99) / 100);
        assertEq(IERC20(USDC).balanceOf(address(this)), out);
        assertEq(IERC20(WETH).balanceOf(address(this)), 7 ether);
        _expectClean(kyber);
    }

    function test_kyberSwap_givenMoreThanTheCalldataSells_returnsTheRest() public {
        if (!forked) return;
        kyber.swap(WETH, USDC, 3.003 ether, 0, KYBER_3_WETH);
        assertEq(IERC20(WETH).balanceOf(address(this)), 7 ether, "the 0.003 WETH unsold came back");
        _expectClean(kyber);
    }

    function test_velora_sellsWethAtItsQuote() public {
        if (!forked) return;
        uint256 out = velora.swap(WETH, USDC, 3 ether, (VELORA_QUOTE * 99) / 100, VELORA_3_WETH);
        assertGe(out, (VELORA_QUOTE * 99) / 100);
        assertEq(IERC20(USDC).balanceOf(address(this)), out);
        _expectClean(velora);
    }

    function test_velora_smallSaleThroughItsUniswapV3Path() public {
        if (!forked) return;
        uint256 out = velora.swap(WETH, USDC, 0.01 ether, (VELORA_SMALL_QUOTE * 99) / 100, VELORA_SMALL_WETH);
        assertGe(out, (VELORA_SMALL_QUOTE * 99) / 100);
        _expectClean(velora);
    }

    function test_eachRouterRefusesTheOtherAggregatorsCalldata() public {
        if (!forked) return;
        vm.expectRevert(abi.encodeWithSelector(SepehrErrors.SelectorNotAllowed.selector, bytes4(0xe3ead59e)));
        kyber.swap(WETH, USDC, 3 ether, 0, VELORA_3_WETH);
        vm.expectRevert(abi.encodeWithSelector(SepehrErrors.SelectorNotAllowed.selector, bytes4(0xe21fd0e9)));
        velora.swap(WETH, USDC, 3 ether, 0, KYBER_3_WETH);
    }

    function test_aMinimumAboveTheSaleReverts() public {
        if (!forked) return;
        vm.expectRevert();
        kyber.swap(WETH, USDC, 3 ether, (KYBER_QUOTE * 110) / 100, KYBER_3_WETH);
    }
}
